{
    "colab_execution": true,

    "experiment_dir": "experiments/agent/test",
    "environment_name": "ALE/Riverraid-v5",    
    "grayscale": true,
    "num_actions": 6,                           
    "action_mapping": [0, 1, 2, 3, 4, 5],    

    "reward_strategy": "scale",                 
    "reward_parameters": {                      
        "transport": 0.0,   
        "scale": 0.01
    },
    
    "warmup_steps": 1000,                       
    "max_episodes": 20,           
    "batch_size": 32,                           
    "replay_memory_size": 50000,              
    "transition_queue_size": 1000,        
    "cache_representations": true,      

    "checkpoint_start": 0,
    "checkpoint_period": 2,
    "save_replay_memory": true,
    "evaluation_period": 5,                   
    "evaluation_episodes": 1,                  
    "record_video": true,                         


    "gamma": 0.99, 
    "n_step": 10,       
    "epsilon_start": 1.0,                     
    "epsilon_end": 0.05,                        
    "epsilon_decay": 0.09,                    


    "sequence_length": 4,                       
    "input_channels": 1,                        
    "input_height": 176,                         
    "input_width": 160,                          

    "conv_channels": 4,                       
    "conv_block": 4,                            
    "conv_dim": 64,                           
    "hidden_dim": 128,                          
    "lstm_layers": 1,                           
    "flatten_output": true,                     
    "latent_dim": 128,                          
    "adapter": true,                            
    "representation_dim": 64,                  


    "encoder_learning_rate": 0.001,            
    "kl_loss_weight": 0.2,                
    "network_optimization_period": 10,
    "key_updates": true, 


    "dnd_max_memory": 15000,                   
    "dnd_num_neighbors": 50,                    

    "dnd_duplicate_threshold": 0.01,            

    "dnd_learning_rate": 0.001,                
    "dnd_q_learning_rate": 0.1,   
    "dnd_exploration_update": false,             
    "dnd_exploration_q_lr": 0.8,              
    "dnd_neighbor_shrink": 0.5,                 

    "dnd_value_dim": 1,                         

    "use_auxiliary": false,                     
    "auxiliary_dim": 1,                         

    "update_strategy": "nec_original",          
    "exploration_update": false,                

    "similarity_function": "exponential_inverse" 
}