{
    "environment_name": "CartPole-v1",          
    "experiment_dir": "experiments/test",       
    
    "warmup_steps": 5000,                       
    "max_episodes": 100,           
    "batch_size": 32,                           
    "replay_memory_size": 100000,              
    "transition_queue_size": 100,        
    "cache_representations": true,      

    "checkpoint_period": 10,
    "evaluation_period": 10,                   
    "evaluation_episodes": 3,                  
    "record_video": true,                         


    "sequence_length": 4,                       
    "input_channels": 3,                        
    "input_height": 176,                         
    "input_width": 160,                          

    "content_dim": 256,                         
    "conv_channels": 256,                       
    "conv_block": 4,                            
    "conv_dim": 2048,                           
    "hidden_dim": 512,                          
    "lstm_layers": 1,                           
    "flatten_output": true,                     

    "representation_dim": 256,                  

    "encoder_learning_rate": 0.001,            
    "kl_loss_weight": 0.2,                
    "network_optimization_period": 4,
    "key_updates": true, 


    "gamma": 0.99, 
    "n_step": 10,                            
    "epsilon_start": 1.0,                       
    "epsilon_end": 0.05,                        
    "epsilon_decay": 100000,                    

    "num_actions": 2,                           

    "dnd_max_memory": 50000,                   
    "dnd_num_neighbors": 50,                    

    "dnd_duplicate_threshold": 0.01,            

    "dnd_learning_rate": 0.001,                
    "dnd_q_learning_rate": 0.1,   
    "dnd_exploration_update": false,             
    "dnd_exploration_q_lr": 0.8,              
    "dnd_neighbor_shrink": 0.5,                 

    "dnd_value_dim": 1,                         

    "use_auxiliary": false,                     
    "auxiliary_dim": 1,                         

    "update_strategy": "nec_original",          
    "exploration_update": false,                

    "similarity_function": "exponential_inverse" 
}