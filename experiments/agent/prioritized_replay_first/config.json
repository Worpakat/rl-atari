{
    "colab_execution": false,

    "experiment_dir": "experiments/agent/prioritized_replay_first",
    "environment_name": "ALE/Riverraid-v5",    
    "grayscale": true,
    "num_actions": 5,                           
    "action_mapping": [1, 2, 3, 4, 5],    

    "reward_strategy": "clip",                 
    "reward_parameters": {                      
        "keep_zeros": true,
        "minimum": -1.0,
        "maximum": 1.0
    },
    "death_penalty": -1.1, 
    
    
    "warmup_steps": 3000,                       
    "max_episodes": 60,           
    "batch_size": 64,                           
    "cache_representations": true,      
    
    "replay_memory_size": 35000,              
    "prioritized_replay": true,                
    "priority_alpha": 0.5,                     
    "priority_epsilon": 1e-5,          

    "transition_queue_size": 1500,                  
    "transition_buffer": {                    
        "transition_delay": 26,                
        "terminal_static_frames": 23
    },


    "resume_training": false,                   
    "resume_checkpoint": "model_ep_60_step_7432.pt",                  
    "load_replay_memory": false,                 


    "checkpoint_start": 0,
    "checkpoint_period": 10,
    "save_replay_memory": false,
    "evaluation_period": 10,                   
    "evaluation_episodes": 3,                  
    "record_video": true,                         


    "gamma": 0.99, 
    "n_step": 30,       
    "epsilon_start": 1.0,                     
    "epsilon_end": 0.05,                        
    "epsilon_decay": 0.995,                    


    "sequence_length": 6,                       
    "input_channels": 1,                        
    "input_height": 176,                         
    "input_width": 160,                          

    "conv_channels": 4,                       
    "conv_block": 4,                            
    "conv_dim": 32,                           
    "hidden_dim": 128,                          
    "lstm_layers": 1,                           
    "flatten_output": true,                     
    "latent_dim": 64,                          
    "adapter": true,                            
    "representation_dim": 32,                  


    "encoder_learning_rate": 5e-6,            
    "kl_loss_weight": 0.0,                
    "network_optimization_period": 5,
    "key_updates": true, 


    "dnd_max_memory": 100000,                   
    "dnd_num_neighbors": 50,                    

    "dnd_duplicate_threshold": 0.1,            

    "dnd_learning_rate": 5e-6,                
    "dnd_q_learning_rate": 0.01,   
    "dnd_exploration_update": false,             
    "dnd_exploration_q_lr": 0.8,              
    "dnd_neighbor_shrink": 0.5,                 

    "dnd_value_dim": 1,                         

    "use_auxiliary": false,                     
    "auxiliary_dim": 1,                         

    "update_strategy": "nec_original",          
    "exploration_update": false,                

    "similarity_function": "exponential_inverse" 
}